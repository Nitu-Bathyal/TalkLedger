# =============================================================================
# TalkLedger Configuration Template
# =============================================================================

# Server Port
PORT=3001

# Environment
NODE_ENV=development

# Database Connection (SQLite file path)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & API Token signing
JWT_SECRET="replace-with-a-secure-random-32-byte-secret"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"

# Optional AI LLM Provider Configuration
# - Leave empty to use the built-in offline NLP engine (zero API keys needed!).
# - If you wish to enable Google Gemini for enhanced entity extraction, provide an API key:
GEMINI_API_KEY=""
