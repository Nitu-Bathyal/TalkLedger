# =============================================================================
# TalkLedger Server Configuration Template
# =============================================================================
PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET="talkledger-secret-key-change-in-production-min32chars"
CORS_ORIGIN="http://localhost:5173"

# =============================================================================
# SPONSOR TRACK: GOOGLE GEMMA 2 (Open-Weights Conversational AI)
# =============================================================================
# Method 1 (Recommended & Ultra-Fast): Groq Cloud LPU (Free tier at https://console.groq.com)
GROQ_API_KEY=""
GEMMA_MODEL="gemma2-9b-it"

# Method 2 (Hugging Face Serverless Inference):
# HF_TOKEN="hf_..."
# GEMMA_MODEL="google/gemma-2-9b-it"

# Method 3 (Local Ollama Runner):
# Run: ollama run gemma2:2b
# GEMMA_API_BASE_URL="http://localhost:11434/v1"
# GEMMA_MODEL="gemma2:2b"

# Note: If no Gemma key is provided, TalkLedger transparently reports Gemma status
# as unconfigured and falls back to deterministic database query tools without crashing.

# =============================================================================
# SPONSOR TRACK: TABPFN-3.5 (Tabular Predictive Repayment Modeling)
# =============================================================================
# Official Prior Labs TabPFN Cloud API (https://priorlabs.ai)
# Evaluation under TabPFN-3.5 License v1.0 (Non-commercial research/evaluation)
TABPFN_API_KEY=""
TABPFN_API_BASE_URL="https://api.tabpfn.com"

# Note: If TABPFN_API_KEY is empty, TalkLedger uses its robust mathematical
# repayment baseline while preserving all tabular feature generation, anonymization,
# risk tiering, and mandatory disclaimer boundaries.
